<comment>
problem = flat_driven_reconnection test case

<job>
problem_id = flat_driven_reconnection

<diffusion>
integrator = rkl2
resistivity = ohmic
resistivity_coeff = spitzer
cfl_diff_heat = 0.5
spitzer_log_lambda = 10.0
spitzer_eta_max = 5e6

<cooling>
enable_cooling = tabular
table_filename = free_free_loss_aluminum_ni_1e18_Zbar_3.cooling
lambda_units_cgs = 1.0
integrator = rk12
max_iter = 1000
cfl = 0.45
d_log_temp_tol = 1e-8
d_e_tol = 1e-8

<thermal_source_solver>
enabled = false

<units>
code_length_cgs = 1.0
code_mass_cgs = 1.0
code_time_cgs = 1.0

<problem/flat_driven_reconnection>
rho_inflow = 2.7e-3
T_inflow = 1e6
array_spacing = 4
h_inflow = 0.5
B_peak = 2e5
rise_time_ns = 200
inflow_profile = gaussian

rho_background = 1e-6
T_background = 1e4

<parthenon/meshblock>
nx1 = 256
nx2 = 256
nx3 = 1

<parthenon/mesh>
refinement = none
nghost = 2

nx1 = 1024
x1min = -4.0
x1max = 4.0
ix1_bc = outflow
ox1_bc = outflow

nx2 = 512
x2min = -2.0
x2max = 2.0
ix2_bc = drivenoutflow
ox2_bc = drivenoutflow

nx3 = 1
x3min = -1.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<hydro>
scratch_level = 1
fluid = glmmhd
eos = adiabatic
riemann = hlld
reconstruction = plm
gamma = 1.6666666666666667
first_order_flux_correct = true
dfloor = 1e-8
Tfloor = 1e3
mean_molecular_weight = 6.25
Z = 13

<parthenon/time>
integrator = vl2
cfl = 0.40
tlim = 1e-8
dt_max = 1e-9

<parthenon/output0>
file_type = hdf5
dt = 1e-9
id = out0
variables = prim, curlBz, dt_heat_local, dt_cool_local, eta
