# AthenaPK - CT pulsed reconnection smoke-test input

<job>
problem_id = pulsed_reconnection

<units>
code_length_cgs = 1.0
code_mass_cgs = 1.0
code_time_cgs = 1.0

<problem/pulsed_reconnection>
current_peak_MA = 20
rho_wire = 2.7e-3
T_wire = 1e6
rho_background = 1e-6
T_background = 1e3
v0 = 0
w = 0.8
w_B = 0.8
array_separation = 6
N = 0
density_perturb_amplitude = 0.0
temperature_perturb_amplitude = 0.0
initial_thermal_profile = wendland
initial_magnetic_profile = wendland
initial_force_balance = true
drive_enable = true
drive_peak_current_MA = 20
drive_t_peak_ns = 200.0
w_drive = 5.0
drive_thermal_profile = wendland
drive_magnetic_profile = wendland
drive_force_balance = true
drive_rho_floor = 2.7e-3
drive_T_floor = 5e6

<parthenon/meshblock>
nx1 = 32
nx2 = 32
nx3 = 1

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 128
x1min = -6.0
x1max = 6.0
ix1_bc = outflow
ox1_bc = outflow

nx2 = 128
x2min = -6.0
x2max = 6.0
ix2_bc = outflow
ox2_bc = outflow

nx3 = 1
x3min = -1.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<hydro>
scratch_level = 1
fluid = ctmhd
eos = adiabatic
riemann = hlld
reconstruction = plm
gamma = 1.6666666666666667
He_mass_fraction = 0.25
dfloor = 1e-8
Tfloor = 1e3

<diffusion>
integrator = unsplit
cfl = 0.3
conduction = none
viscosity = none
resistivity = ohmic
resistivity_coeff = fixed
ohm_diff_coeff_code = 1e3

<parthenon/time>
integrator = rk2
cfl = 0.4
tlim = 1e-8
nlim = 1

<parthenon/output0>
file_type = hdf5
dt = 1e-8
id = out0
variables = prim, Bface, curlBz, divv, eta

<parthenon/output1>
file_type = hst
dn = 1
