# AthenaPK - CT pulsed reconnection smoke-test input

<job>
problem_id = pulsed_reconnection

<units>
code_length_cgs = 1.0
code_mass_cgs = 1.0
code_time_cgs = 1e-7

<problem/pulsed_reconnection>
B_peak_gauss = 1.5954317e6
rho_wire = 2.7e-4
T_wire = 1e6
rho_background = 1e-7
T_background = 1e3
v0 = 0
w_initial_rho = 0.8
w_initial_T = 0.8
w_B = 0.8
array_separation = 6
N = 0
density_perturb_amplitude = 0.0
temperature_perturb_amplitude = 0.0
initial_rho_profile = wendland
initial_T_profile = wendland
initial_magnetic_profile = wendland
initial_force_balance = true
drive_enable = true
drive_B_peak_gauss = 1.5954317e6
drive_t_peak_ns = 200.0
w_drive_rho = 0.80
w_drive_T = 0.80
w_drive_magnetic = 0.80
drive_rho_profile = wendland
drive_T_profile = wendland
drive_magnetic_profile = wendland
# Density and temperature supports independently follow the finite magnetic-pulse shape.
# Select "fixed" instead to keep either support at full amplitude while driving is enabled.
drive_rho_time_profile = sin2
drive_T_time_profile = sin2
drive_force_balance = true
drive_rho_profile_floor = 2.7e-3
drive_T_profile_floor = 5e6

<parthenon/meshblock>
nx1 = 128
nx2 = 128
nx3 = 1

<parthenon/mesh>
refinement = static
nghost = 2
nx1 = 512
x1min = -12.0
x1max = 12.0
ix1_bc = outflow
ox1_bc = outflow

nx2 = 512
x2min = -12.0
x2max = 12.0
ix2_bc = outflow
ox2_bc = outflow

nx3 = 1
x3min = -1.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<parthenon/static_refinement0>
x1min = -4.0
x1max =  4.0
x2min = -0.1
x2max =  0.1
x3min = -0.0
x3max =  0.0
level =  2

<hydro>
scratch_level = 1
fluid = ucthlldmhd
eos = adiabatic
riemann = hlld
reconstruction = plm
gamma = 1.6666666666666667
mean_molecular_weight = 6.25
mean_ionization_state = 3
dfloor = 1e-8
Tfloor = 1e3

<diffusion>
integrator = unsplit
cfl = 0.3
conduction = none
viscosity = none
resistivity = ohmic
resistivity_coeff = fixed
ohm_diff_coeff_code = 1e-3

<cooling>
enable_cooling = tabular
table_filename = free_free_loss_aluminum_ni_1e18_Zbar_3.cooling
lambda_units_cgs = 1.0
density_normalization = electron
integrator = rk12
max_iter = 1000
cfl = 0.45
d_log_temp_tol = 1e-8
d_e_tol = 1e-8

<parthenon/time>
integrator = rk2
cfl = 0.4
tlim = 10.0

<parthenon/output0>
file_type = hdf5
dt = 0.1
id = out0
variables = prim, Bface, curlBz, divB, divv, eta

<parthenon/output1>
file_type = hst
dn = 1
