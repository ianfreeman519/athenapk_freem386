<comment>
problem = 2D MHD field loop

# TODO(pgrete) get rid of this leftover in Parthenon to define a basename
<parthenon/job>
problem_id = ../plotting/smooth_mhd_vortex_results/parthenon

<job>
problem_id = smooth_mhd_vortex


<problem/smooth_mhd_vortex>
compute_error = true  # when 'true' outputs L1 error compared to initial data


<parthenon/mesh>
refinement = none
nghost = 2

nx1 = 128
x1min = -5.0
x1max = 5.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 128
x2min = -5.0
x2max = 5.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 128
nx2 = 128
nx3 = 1

<parthenon/time>
integrator = rk2
cfl = 0.3
tlim = 10.0
nlim = 100000
perf_cycle_offset = 2 # number of inital cycles not to be included in perf calc

<hydro>
fluid = ctmhd
eos = adiabatic
riemann = hlld
reconstruction = plm
gamma = 1.666666666666667 # gamma = C_p/C_v
scratch_level = 1 # 0 is actual scratch (tiny); 1 is HBM

<parthenon/output0>
file_type = hdf5
dt = 10.0
id = prim
variables = prim

<parthenon/output1>
file_type = hst
dt = 0.05
