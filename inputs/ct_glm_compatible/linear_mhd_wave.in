<comment>
problem = 2D MHD linear wave convergence

<parthenon/job>
problem_id = /mnt/home/wysongj2

<job>
problem_id = linear_wave_mhd

<problem/linear_wave_mhd>
compute_error = true  # when 'true' outputs L1 error compared to initial data
wave_flag = 0         # Wave family number (0 - 6 for mhd)
amp       = 1.0e-6    # Wave Amplitude
vflow     = 0.0       # background flow velocity
test      = true
ang_2     = 0.0    # make 0.0 for 2D runs

<parthenon/mesh>
refinement = none
nghost = 2

nx1 = 64
x1min = 0.0
x1max = 3.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 32
x2min = 0.0
x2max = 1.5
ix2_bc = periodic
ox2_bc = periodic

nx3 = 32
x3min = 0.0
x3max = 1.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1=32
nx2=16
nx3=16


<parthenon/time>
integrator = rk2
cfl = 0.3
tlim = 1.0
nlim = 100000
perf_cycle_offset = 2 # number of inital cycles not to be included in perf calc

<hydro>
fluid = ctmhd
eos = adiabatic
riemann = hlld
reconstruction = plm
gamma = 1.666666666666667 # gamma = C_p/C_v
scratch_level = 1 # 0 is actual scratch (tiny); 1 is HBM

<parthenon/output0>
file_type = hdf5
dt = -0.05
variables = prim

<parthenon/output1>
file_type = hst
dt = 0.05
